<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <ProjectGuid>{F8AA5F38-1B7B-4B0C-9D2C-4E1A2B3C0001}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>HsDecktrackBgReader</RootNamespace>
    <AssemblyName>HsDecktrackBgReader</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <PlatformTarget>x86</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\x86\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <PlatformTarget>x86</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\x86\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <!--
    HDT references: by default we point at refs/ next to the project. If
    refs/ is empty (clean checkout) the AutoStageHdtRefs target below runs
    stage-hdt-refs.ps1 to populate it from the locally-installed HDT.
    Override the auto-discovery by setting HdtRoot, e.g.
      msbuild HsDecktrackBgReader.csproj /p:HdtRoot=D:\Games\HDT\app-1.32.5
  -->
  <ItemGroup>
    <Reference Include="HearthstoneDeckTracker">
      <HintPath>refs\HearthstoneDeckTracker.exe</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="HearthDb">
      <HintPath>refs\HearthDb.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="HsDecktrackBgReaderPlugin.cs" />
    <Compile Include="EntityDumper.cs" />
    <Compile Include="BgStateExtractor.cs" />
    <Compile Include="LocalHttpServer.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <!--
    Auto-stage HDT reference binaries before MSBuild tries to resolve them.
    Runs only when refs/ is missing or empty, so once it's populated subsequent
    builds skip the script entirely. Pass HdtRoot as a property to override.
  -->
  <Target Name="AutoStageHdtRefs"
          BeforeTargets="ResolveAssemblyReferences"
          Condition="!Exists('$(MSBuildProjectDirectory)\refs\HearthstoneDeckTracker.exe') Or !Exists('$(MSBuildProjectDirectory)\refs\HearthDb.dll')">
    <Message Importance="high" Text="refs/ missing HDT binaries — running stage-hdt-refs.ps1" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\stage-hdt-refs.ps1&quot; -RefsDir &quot;$(MSBuildProjectDirectory)\refs&quot; $(_HdtRootArg)"
          ConsoleToMSBuild="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_StageOutput" />
    </Exec>
  </Target>
  <PropertyGroup>
    <_HdtRootArg Condition="'$(HdtRoot)' != ''">-HdtRoot &quot;$(HdtRoot)&quot;</_HdtRootArg>
  </PropertyGroup>

  <Target Name="AfterBuild" Condition=" '$(Configuration)' == 'Debug' ">
    <ItemGroup>
      <PluginOut Include="$(TargetPath)" />
      <PluginOut Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    </ItemGroup>
    <MakeDir Directories="$(AppData)\HearthstoneDeckTracker\Plugins\HsDecktrackBgReader" />
    <Copy SourceFiles="@(PluginOut)" DestinationFolder="$(AppData)\HearthstoneDeckTracker\Plugins\HsDecktrackBgReader" />
  </Target>
</Project>
